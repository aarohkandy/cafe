    9    'idm   ' = longitudinal array size
    7    'jdm   ' = latitudinal  array size
    0    'mapflg' = map flag (-1=unknown,0=mercator,1=latlon,2=polar)
plon:  min,max =    -180.00000   179.92000
plat:  min,max =      -0.12000     0.12000
qlon:  min,max =    -179.96000   179.96000
pang:  min,max =       0.00000     0.00000
